# Example values override for running openstudio-server on an OpenStack
# Kubernetes cluster provisioned by Azimuth.
#
# Usage:
#   helm install openstudio-server ./openstudio-server -f openstack/values-openstack.yaml
#
# This assumes the cluster already exists (provisioned via Azimuth) and has
# the Cinder CSI driver installed. It does not create or configure the
# Kubernetes cluster itself.
#
# NOTE: the actual deployment file `openstack/values-openstack.yaml` is
# git-ignored and can contain local-secret overrides. Keep this template in
# sync with the non-ignored values file when adding provider-specific values,
# especially for OpenStack/Azimuth behavior that is not automatically
# generated by the chart or scripts.

provider:
  name: "openstack"

# The in-cluster Kubernetes cluster-autoscaler does NOT work on
# Azimuth-provisioned OpenStack clusters and must stay disabled here -- see
# the detailed comment in values-openstack.yaml for why. In short:
# "openstack" is not a valid cluster-autoscaler --cloud-provider (only
# "magnum" or "clusterapi" are), and even "clusterapi" (the theoretically
# correct value for Azimuth's CAPI-provisioned clusters) needs access to a
# management-cluster kubeconfig that Azimuth does not expose to tenants.
# Scale the worker node group directly from the Azimuth dashboard/API
# instead.
clusterAutoscaler:
  enabled: false

# Global image registry used to prefix unqualified image references
# (e.g. hooks' "bitnami/kubectl:latest" -> "mirror.example.com/my-prefix/bitnami/kubectl:latest").
# Images that already carry an explicit registry host (the nrel/* images below)
# are left untouched by the imageWithRegistry helper.
global:
  images:
    registry: "mirror.example.com"
    repositoryPrefix: "my-prefix"

# Local image registry (optional)
# Enable to deploy an in-cluster Docker registry (distribution/registry:2) and
# rewrite all workload images to pull from it.
localRegistry:
  enabled: false
  rewriteImages: true
  persistence:
    storageClass: "ssd"
    size: 50Gi

# CRITICAL: Generate your own secure secret key!
# Run: openssl rand -hex 64
web:
  secret_key_value: "{{WEB_SECRET_KEY}}"
  # Sizing below suits small runs. For very large runs (~8,000+ workers) the
  # single web pod saturates (slow pages, proxy 504s). Measured at ~8,300
  # workers: ~210GiB RSS, ~10 busy cores. To use it, replace the `container`
  # block below and add passenger_memory_per_process at the `web:` level:
  #
  #   passenger_memory_per_process: 290   # max_pool ~594 at 224Gi requests
  #   container:
  #     image: "nrel/openstudio-server:3.8.0-1"
  #     resources:
  #       requests:
  #         cpu: 16
  #         memory: "224Gi"
  #       # no limits: throttling/OOM hurt more. max_pool is derived from the
  #       # memory request, so the web node's ALLOCATABLE memory must cover
  #       # web + mongo (same node) + kubelet/system reserve, or the node will
  #       # hit memory pressure and may evict/OOM mongo.
  #
  # Also cap worker-hpa maxReplicas: the proxy's 600s read timeout only
  # masks saturation, it does not relieve it.
  container:
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 6
        memory: "50Gi"
      limits:
        cpu: 12
        memory: "60Gi"

# NodePort so the nginx proxy VM (openstack/terraform-proxy-vm) can reach the
# web service on the node IPs, bypassing the Octavia load balancer.
web_svc:
  type: NodePort
  nodePorts:
    http: 32105
    https: 32106

# Azimuth's Cluster API node groups auto-label nodes with
# "capi.stackhpc.com/node-group: web|worker" (not the "nodegroup: web-group"
# / "nodegroup: worker-group" this chart defaults to elsewhere). Since
# Azimuth autoscales node groups, newly-added nodes get this label
# automatically — using it here means you never have to hand-label nodes,
# and new nodes are immediately schedulable.
node_group:
  label_key: "capi.stackhpc.com/node-group"
  web_value: "web"
  worker_value: "worker"
  # "required" ensures pods ONLY schedule on correctly labeled nodes
  affinity_mode: "required"

cluster:
  name: "openstudio-server-azimuth-openstack"

# Persistent storage, sized from prior production usage on this cluster
# (~3.9TB total: 3900Gi NFS backend + 192Gi db + 120Gi redis).
# storageClass.reclaimPolicy is left at the chart default (Delete) so
# uninstalling/recreating never leaves an orphaned Cinder volume behind if
# manual cleanup is forgotten.
nfs-server-provisioner:
  persistence:
    size: 3900Gi
  resources:
    requests:
      cpu: "500m"
      memory: "18Gi"
    limits:
      cpu: "2"
      memory: "28Gi"
  # This subchart is a separate vendored dependency with its own hardcoded
  # default affinity (nodegroup: web-group) -- it does NOT read this
  # chart's node_group.* values above. Override it directly to match
  # Azimuth's actual native node label, or this pod will never schedule.
  # Helm deep-merges values maps rather than replacing them, so the
  # subchart's own default requiredDuringSchedulingIgnoredDuringExecution
  # (nodegroup: web-group) must be explicitly nulled out here -- otherwise
  # it stays merged in alongside this and, being a hard AND constraint,
  # permanently blocks scheduling since no node has that label.
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution: null
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: capi.stackhpc.com/node-group
                operator: In
                values:
                  - web

nfs_pvc:
  # Frontend RWX claim consumed by web/rserve/background pods. Keep this
  # below nfs-server-provisioner.persistence.size (~85-95% of it).
  storage: "3500Gi"

# Mirror registry (avoids Docker Hub pull-rate limits from this cluster) and
# CPU/memory sizing tuned from prior production usage on this cluster.
# Adjust registry/prefix/tags/resources below to match your own environment.
db:
  # CRITICAL: Change these defaults for production!
  username: "openstudio"
  password: "{{DB_PASSWORD}}"
  container:
    image: "mongo:6.0.7"
    resources:
      requests:
        cpu: 4
        memory: "22Gi"
      limits:
        cpu: 8
        memory: "44Gi"
  persistence:
    size: 192Gi

redis:
  # CRITICAL: Change this default for production!
  password: "{{REDIS_PASSWORD}}"
  maxclients: 40000
  container:
    image: "redis:6.0.9"
    resources:
      requests:
        cpu: 8
        memory: "16Gi"
      limits:
        cpu: 16
        memory: "24Gi"
  persistence:
    size: 120Gi

redis_svc:
  name: "queue"
  label: "redis"
  port: 6379
  url: "redis://:{{REDIS_PASSWORD}}@queue:6379"

rserve:
  number_of_workers: "15"
  container:
    image: "nrel/openstudio-rserve:3.8.0-1"
    resources:
      requests:
        cpu: 2
        memory: "4Gi"
      limits:
        cpu: 4
        memory: "8Gi"

web_background:
  # ONLY 1 REPLICA ALLOWED - per openstudio-server developer
  # (only worker deployment can scale >1 replica)
  replicas: 1
  # Dynamic worker calculation (auto-parses container.resources.limits.memory):
  #   workers = floor(limit_memory_MiB / worker_memory_mib)
  #   e.g., "32Gi" limit + 335 MiB/worker = 97 workers
  #
  # 2026-09-05: raised 300 -> 335 from live measurement on the OpenStack
  # cluster. A web-background pod running 150 Resque workers held a flat
  # steady-state cgroup working set of 50,287 MiB (49.1GiB) after 33h with
  # 0 restarts => 335 MiB/worker, not 300.
  #
  # This matters because THIS file sets a memory *limit* (unlike the live
  # openstack values, which deliberately omit one). At 300 the formula
  # derives floor(32768/300) = 109 workers, which actually need
  # 109 * 335 = ~35.7GiB against a 32Gi limit -- i.e. the pod boots more
  # workers than its own limit can hold and is OOMKilled once they warm up,
  # silently destroying every in-flight analysis (this build has no
  # requeue-on-dirty-exit in RunAnalysis or RunSimulateDataPoint). At 335
  # the formula derives 97 workers (~31.7GiB), which fits.
  worker_memory_mib: 335
  container:
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 4
        memory: "24Gi"
      limits:
        cpu: 8
        memory: "32Gi"

worker:
  # CAPACITY PLANNING: simulation wall-clock is dominated by the *building type*
  # of the analysis, not by this pod's resources. Measured on this cluster
  # 2026-09-05 across 271k completed datapoints, all sharing a byte-identical
  # 21-measure workflow and identical simulation_settings (4 timesteps/hr,
  # annual) -- the ONLY differing input was
  # create_bar_from_building_type_ratios.bldg_type_a:
  #
  #   SecondarySchool  159 min avg   (~108 zones)
  #   PrimarySchool     72 min avg
  #   RetailStandalone  26 min avg
  #   Warehouse         23 min avg
  #   MediumOffice      20 min avg
  #   RetailStripmall   17 min avg
  #   SmallOffice        9 min avg
  #
  # That is a ~15x spread against a run_workflow_timeout that is submitted
  # per-analysis by the client (NOT set anywhere in this chart) and was a
  # uniform 14400s / 4h. Result: 48.6% of SecondarySchool datapoints blew
  # through the timeout and, because this build has no requeue-on-dirty-exit,
  # failed permanently -- 91% of ALL fleet datapoint failures were that one
  # building type.
  #
  # Do NOT try to fix this by giving workers more CPU. A timing-out E+ process
  # was verified at 99.8% CPU, state R, nr_throttled=0 -- it is compute-bound
  # on HVAC solver iterations (repeated "Coil control failed ... part-load
  # ratio outside 0-1" from the heat-pump RTU measure shrinking the system
  # timestep), not starved or throttled. Raise run_workflow_timeout for
  # school-type prototypes (~28800) and/or fix the measure.
  # Full write-up: docs/simulation-timeout-building-type-incident.md
  container:
    image: "nrel/openstudio-server:3.8.0-1"
    resources:
      requests:
        cpu: 1
        memory: "1.2Gi"
      limits:
        cpu: 1
        memory: "1.2Gi"
    # CRITICAL: Reduced from 1800 (30 min) to 60s for faster uninstall cleanup.
    # Pre-stop hook handles graceful shutdown within this window.
    terminationGracePeriodSeconds: 60
    # Cap per-worker scratch space so one runaway job can't fill a node's
    # disk and take down every other pod on it via DiskPressure eviction.
    emptyDirSizeLimit: ""

worker_hpa:
  targetCPUUtilizationPercentage: 5
  # Keep this at (or below) the number of worker pods the cluster can ACTUALLY
  # schedule and pull images for. There is no working cluster-autoscaler on
  # Azimuth, so this is a hard ceiling, not a target.
  #
  # 2026-09-05 incident: this was set high enough that 1,125 worker pods were
  # stuck Pending ("Insufficient cpu") or ImagePullBackOff (the pulp-dev mirror
  # was down again). Those broken pods still counted toward the replica total,
  # so the HPA sat pinned at 99%/max and had no headroom left to respond to
  # anything. Trimming maxReplicas to the schedulable count cleared it:
  # 942 Pending -> 0, ImagePull failures 183 -> 65, and measured throughput
  # went from ~87 jobs/min to ~208 jobs/min.
  #
  # Trimming maxReplicas is SAFE with respect to in-flight simulations: a
  # ReplicaSet evicts unscheduled/not-ready pods before Running ones, so the
  # scale-down removed only broken pods and preserved all 8,235 running sims.
  # This matters because this build has no requeue-on-dirty-exit -- any pod
  # killed mid-simulation permanently fails its datapoint.
  #
  # Raising it again requires actually adding nodes in the Azimuth dashboard
  # first; bumping this number alone just recreates the Pending backlog.
  maxReplicas: 10000
  # Throttle scale-down specifically (much lower than the 950/60s shared
  # with scale-up) to spread worker terminations out over time rather than
  # bursting hundreds of simultaneous kills, which risks overwhelming a
  # node's container runtime kill pathway if many land on the same node at
  # once. Scale-up speed is unaffected. Trade-off: excess worker capacity
  # is released more slowly after a workload drop-off.
  scaleDownPolicyValue: 50

# Load balancer configuration
# PROVIDER-SPECIFIC (openstack): disabled by default. The chart-managed
# ingress-load-balancer is redundant when the application is reached via the
# proxy VM + internal VIP path, and Octavia's ovn-backed VIPs were observed to
# fail externally in this environment. Keep it off unless the platform has a
# working load-balancer backend.
load_balancer:
  enabled: false
  name: "ingress-load-balancer"
  internal: false
  externalTrafficPolicy: "Local"
  label: "web"
  acm_certificate_arn: ""
  idle_timeout: "300"
  ports:
    http_name: "http"
    http_port: 80
    http_protocol: "TCP"
    https_name: "https"
    https_port: 443
    https_protocol: "TCP"